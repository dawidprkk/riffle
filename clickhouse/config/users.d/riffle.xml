<?xml version="1.0"?>
<!--
  Server settings Riffle depends on. Refreshable materialized views (the L2/L3
  derived path) are generally available on the pinned 25.8 line, so no
  experimental gate is needed here.
-->
<clickhouse>
    <profiles>
        <default>
            <max_execution_time>60</max_execution_time>
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
        </default>
    </profiles>
</clickhouse>
